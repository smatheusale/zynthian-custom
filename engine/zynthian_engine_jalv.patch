+    def _dispatch_firmware_midi(self, processor, chan, midi_info):
+        # Send the Bank Select + Program Change ONLY to this chain's zmop
+        # output, not via the global ui_send_*/zynmidi broadcast. Broadcasting
+        # on `chan` leaks the PC to every other chain sharing that MIDI channel
+        # (e.g. a layered FluidSynth or LinuxSampler), hijacking their program.
+        # zmop_send_* targets this processor's chain alone.
+        try:
+            zmop = processor.chain.zmop_index
+        except Exception:
+            zmop = None
+        try:
+            if zmop is not None:
+                lib_zyncore.zmop_send_ccontrol_change(zmop, chan, 120, 0)
+                lib_zyncore.zmop_send_ccontrol_change(zmop, chan, 123, 0)
+        except Exception as e:
+            logging.warning(f"All-Sound-Off / All-Notes-Off failed: {e}")
+        # JE8086 PANEL MODE: 0=Patch (A/B banks), 1=Performance (P bank, LSB=2).
+        # Sent via jalv stdin `set <index> <value>` which speaks patch:Set.
+        if self.plugin_name == "JE8086" and isinstance(midi_info, (list, tuple)) and len(midi_info) == 3:
+            panel_mode = 1 if midi_info[1] == 2 else 0
+            try:
+                self.proc_cmd(f"set 127 {panel_mode}")
+            except Exception as e:
+                logging.warning(f"JE8086 PANEL MODE set failed: {e}")
+        if zmop is None:
